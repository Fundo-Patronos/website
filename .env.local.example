# Firebase (client-side, VITE_ prefix required) — usado no browser para auth
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef

# Railway Postgres (server-side only) — fonte de dados da Área do Doador e do /admin
DATABASE_URL=postgresql://user:password@host:port/database

# Firebase Admin (server-side only) — verifica o ID token nas rotas /api protegidas
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Controle de acesso ao /admin (server-side) — lista de emails separados por vírgula
ADMIN_EMAILS=admin1@patronos.org,admin2@patronos.org

# Email de teste end-to-end (login do doador "Renan Nardoni (Teste)")
TEST_USER_EMAIL=teste@example.com
